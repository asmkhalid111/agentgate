{
  "target_rps": 100,
  "warmup_sec": 30,
  "direct_sec": 60,
  "governed_sec": 60,
  "runs": 3,
  "workers": 20,
  "endpoints": {
    "gateway_mcp": "http://localhost:8081/mcp",
    "downstream_direct": "http://localhost:8083/api/orders/ORD-BENCH-01",
    "keycloak_token": "http://localhost:8180/realms/agentgate/protocol/openid-connect/token"
