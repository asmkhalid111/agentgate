{
  "realm": "agentgate",
  "enabled": true,
  "displayName": "AgentGate Governance Realm",
  "roles": {
    "realm": [
      {
        "name": "ADMIN",
        "description": "Administrator role with full tool management and emergency kill switch privileges"
      },
      {
        "name": "APPROVER",
        "description": "Security officer role authorized to approve or edit high-risk tool calls"
      },
      {
        "name": "USER",
        "description": "Standard service account role"
      },
      {
        "name": "AGENT_SERVICE",
        "description": "Registered agent service accounts"
      },
      {
        "name": "DELEGATING_USER",
        "description": "Human users allowed to authorize delegated access"
      }
    ]
  },
  "clientScopes": [
    {
      "name": "tool:delegate",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "Allow the finance agent to act on your behalf in AgentGate"
      },
      "protocolMappers": [
        {
          "name": "AgentGate assertion audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "agentgate-gateway",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "name": "agent:invoke",
      "description": "Authority to connect and invoke tools through the AgentGate MCP endpoint",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      }
    },
    {
      "name": "tool:admin",
      "description": "Authority to execute restricted administrative maintenance tools",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      }
    },
    {
      "name": "delegation:act_as_user",
      "description": "Authority to act on behalf of end users with verified azp binding",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      }
    }
  ],
  "clients": [
    {
      "clientId": "agent-finance-bot",
      "name": "Finance Automation Bot",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "finance_dev_secret_123",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": true,
      "consentRequired": true,
      "redirectUris": [
        "http://127.0.0.1:8765/callback"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "optionalClientScopes": [
        "tool:delegate"
      ],
      "directAccessGrantsEnabled": false,
      "publicClient": false,
      "protocol": "openid-connect",
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "roles",
        "profile",
        "email",
        "agent:invoke",
        "delegation:act_as_user",
        "basic"
      ],
      "protocolMappers": [
        {
          "name": "agentgate subject",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "agent-support-bot",
      "name": "Customer Support Bot",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "support_dev_secret_123",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "publicClient": false,
      "protocol": "openid-connect",
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "roles",
        "profile",
        "email",
        "agent:invoke"
      ]
    },
    {
      "clientId": "agent-unauthorized-bot",
      "name": "Unauthorized Rogue Bot",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "unauth_dev_secret_123",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "publicClient": false,
      "protocol": "openid-connect",
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "roles",
        "profile",
        "email"
      ]
    },
    {
      "clientId": "agentgate-web",
      "name": "AgentGate Approval Web Portal",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "${KEYCLOAK_WEB_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "publicClient": false,
      "protocol": "openid-connect",
      "redirectUris": [
        "http://localhost:8080/login/oauth2/code/keycloak"
      ],
      "webOrigins": [
        "http://localhost:8080"
      ],
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "roles",
        "profile",
        "email"
      ],
      "protocolMappers": [
        {
          "name": "realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "service-account-agent-finance-bot",
      "enabled": true,
      "serviceAccountClientId": "agent-finance-bot",
      "realmRoles": [
        "USER",
        "AGENT_SERVICE"
      ]
    },
    {
      "username": "service-account-agent-support-bot",
      "enabled": true,
      "serviceAccountClientId": "agent-support-bot",
      "realmRoles": [
        "USER",
        "AGENT_SERVICE"
      ]
    },
    {
      "username": "service-account-agent-unauthorized-bot",
      "enabled": true,
      "serviceAccountClientId": "agent-unauthorized-bot",
      "realmRoles": [
        "USER",
        "AGENT_SERVICE"
      ]
    },
    {
      "username": "human-approver",
      "enabled": true,
      "email": "approver@agentgate.dev",
      "firstName": "Security",
      "lastName": "Approver",
      "realmRoles": [
        "APPROVER"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "approver_dev_password_123",
          "temporary": false
        }
      ]
    },
    {
      "username": "human-admin",
      "enabled": true,
      "email": "admin@agentgate.dev",
      "firstName": "Security",
      "lastName": "Administrator",
      "realmRoles": [
        "ADMIN"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "${KEYCLOAK_HUMAN_ADMIN_PASSWORD}",
          "temporary": false
        }
      ]
    },
    {
      "username": "human-user",
      "enabled": true,
      "email": "user@agentgate.dev",
      "firstName": "Standard",
      "lastName": "User",
      "realmRoles": [
        "USER",
        "DELEGATING_USER"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "user_dev_password_123",
          "temporary": false
        }
      ]
    }
  ],
  "scopeMappings": [
    {
      "clientScope": "agent:invoke",
      "roles": [
        "AGENT_SERVICE"
      ]
    },
    {
      "clientScope": "delegation:act_as_user",
      "roles": [
        "AGENT_SERVICE"
      ]
    },
    {
      "clientScope": "tool:delegate",
      "roles": [
        "DELEGATING_USER"
      ]
    }
  ]
}
